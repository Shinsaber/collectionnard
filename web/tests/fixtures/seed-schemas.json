[
  {
    "id": "b0000000-0000-0000-0000-000000000001",
    "name": "Series",
    "schema": {
      "type": "object",
      "required": ["title"],
      "x-label": "{title}",
      "x-order": ["title", "synopsis", "start_year", "end_year", "images"],
      "x-labels": {
        "fr": {
          "title": "Titre",
          "synopsis": "Synopsis",
          "start_year": "Année de début",
          "end_year": "Année de fin",
          "images": "Images"
        },
        "en": {
          "title": "Title",
          "synopsis": "Synopsis",
          "start_year": "Start Year",
          "end_year": "End Year",
          "images": "Images"
        }
      },
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "synopsis": {
          "type": "object",
          "x-widget": "i18n-text",
          "properties": {
            "fr": { "type": "string" },
            "en": { "type": "string" }
          },
          "additionalProperties": false
        },
        "start_year": { "type": "integer", "minimum": 1900 },
        "end_year": { "type": "integer", "minimum": 1900 },
        "images": {
          "type": "object",
          "x-widget": "image-gallery",
          "x-image-categories": {
            "poster": { "ratio": "2/3" },
            "screenshot": { "ratio": "16/9" },
            "banner": { "ratio": "3/1" }
          },
          "properties": {
            "default_image": { "type": "string" },
            "poster": { "type": "array", "items": { "type": "string" } },
            "screenshot": { "type": "array", "items": { "type": "string" } },
            "banner": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  {
