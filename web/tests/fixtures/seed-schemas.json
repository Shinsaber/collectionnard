          "start_year": "Start Year",
          "end_year": "End Year",
          "images": "Images"
        }
      },
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "synopsis": {
          "type": "object",
          "x-widget": "i18n-text",
          "properties": {
            "fr": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "start_year": {
          "type": "integer",
          "minimum": 1900
        },
        "end_year": {
          "type": "integer",
          "minimum": 1900
        },
        "images": {
          "type": "object",
          "x-widget": "image-gallery",
          "x-image-categories": {
            "poster": {
              "ratio": "2/3"
            },
            "screenshot": {
              "ratio": "16/9"
            },
            "banner": {
              "ratio": "3/1"
            }
          },
          "properties": {
            "default_image": {
              "type": "string"
            },
            "poster": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "screenshot": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "banner": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
