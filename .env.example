# Variables lues par docker-compose.yml. Copier ce fichier en `.env` (ignoré par git)
# puis remplacer les valeurs. Ne jamais committer `.env`.

# Mot de passe PostgreSQL (caractères alphanumériques : il est inséré dans DATABASE_URL).
POSTGRES_PASSWORD=colec

# Secret de signature des JWT : 32 caractères minimum, aléatoire.
# Générer avec :  openssl rand -base64 48
JWT_SECRET=

# Durées de vie des tokens (format Go : 15m, 1h, 720h) et limite d'appels /auth/* par IP et par minute.
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=720h
# LOGIN_RATE_LIMIT=10

# Mettre à true uniquement si l'API n'est joignable qu'à travers un reverse-proxy qui pose X-Real-IP
# (c'est le cas du service web/nginx de docker-compose, qui le force déjà).
# TRUSTED_PROXY=false

# Borne du graphe de relations (nœuds) ; au-delà la réponse est marquée truncated.
# GRAPH_MAX_NODES=500

# Jeu de données de dev (admin/admin, Breaking Bad) appliqué par le service `migrate` si la base est vide.
# Mettre false en production.
# SEED_ON_EMPTY=true

# Format des logs du serveur : json (défaut) ou text.
# LOG_FORMAT=json

# User-Agent envoyé à Wikidata et à la BnF (import depuis les sources externes) : leurs règles
# demandent un nom et un contact (URL ou e-mail). Défaut : Collectionnard/1.0 (+URL du dépôt).
# EXTERNAL_USER_AGENT=Collectionnard/1.0 (+https://exemple.org ; contact@exemple.org)
