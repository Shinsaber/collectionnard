# Variables lues par docker-compose.yml. Copier ce fichier en `.env` (ignoré par git)
# puis remplacer les valeurs. Ne jamais committer `.env`.

# Mot de passe PostgreSQL (caractères alphanumériques : il est inséré dans DATABASE_URL).
POSTGRES_PASSWORD=colec

# Secret de signature des JWT : 32 caractères minimum, aléatoire.
# Générer avec :  openssl rand -base64 48
JWT_SECRET=

# Durées de vie des tokens (format Go : 15m, 1h, 720h) et limite d'appels /auth/* par IP et par minute.
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=720h
# LOGIN_RATE_LIMIT=10
