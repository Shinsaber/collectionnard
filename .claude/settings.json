{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(nix develop -c go build:*)",
      "Bash(nix develop -c go vet:*)",
      "Bash(nix develop -c go test:*)",
      "Bash(nix develop -c gofmt:*)",
      "Bash(nix develop -c golangci-lint:*)",
      "Bash(nix develop -c govulncheck:*)",
      "Bash(nix develop -c npm run type-check:*)",
      "Bash(nix develop -c npm run build:*)",
      "Bash(nix develop -c npm run lint:*)",
      "Bash(nix develop -c npm run format:*)",
      "Bash(nix develop -c npm test:*)",
      "Bash(nix develop -c npm audit:*)",
      "Bash(nix develop path:*)",
      "Bash(nix flake check:*)",
      "Bash(nix flake lock:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint:*)",
      "Bash(govulncheck:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm test:*)",
      "Bash(npm audit:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(docker compose down:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.*.local)",
      "Read(./web/node_modules/**)"
    ]
  }
}
