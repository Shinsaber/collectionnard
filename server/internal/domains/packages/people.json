      "display_order": 130,
      "attributes_schema": {
        "type": "object",
        "x-label": "{first_name} {last_name}",
        "x-order": [
          "last_name",
          "first_name",
          "native_name",
          "nationality",
          "birth_date",
          "biography",
          "images",
          "external_ids",
          "sources"
        ],
        "x-title": {
          "en": "Person",
          "fr": "Personne"
        },
        "required": [
          "last_name"
        ],
        "x-labels": {
          "en": {
            "images": "Images",
            "sources": "Sources",
            "biography": "Biography",
            "last_name": "Last name",
            "birth_date": "Birth date",
            "first_name": "First name",
            "nationality": "Nationality (country code)",
            "native_name": "Native name",
            "external_ids": "External IDs"
          },
          "fr": {
            "images": "Images",
            "sources": "Sources",
            "biography": "Biographie",
            "last_name": "Nom",
            "birth_date": "Date de naissance",
            "first_name": "Prénom",
            "nationality": "Nationalité (code pays)",
            "native_name": "Nom natif",
            "external_ids": "Identifiants externes"
          }
        },
        "properties": {
          "images": {
            "type": "object",
            "x-widget": "image-gallery",
            "properties": {
              "portrait": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default_image": {
                "type": "string"
              }
            },
            "x-image-categories": {
              "portrait": {
                "ratio": "3/4"
              }
            },
            "additionalProperties": false
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source"
              ],
              "properties": {
                "source": {
                  "enum": [
                    "wikidata",
                    "bnf",
                    "manual"
                  ],
                  "type": "string"
                },
                "retrieved_at": {
                  "type": "string",
                  "format": "date"
                }
              },
              "additionalProperties": false
            }
          },
          "biography": {
            "type": "object",
            "x-widget": "i18n-text",
            "properties": {
              "en": {
                "type": "string"
              },
              "fr": {
                "type": "string"
              }
            },
            "propertyNames": {
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "last_name": {
            "type": "string",
            "minLength": 1
          },
          "birth_date": {
            "type": "string",
            "format": "date"
          },
          "first_name": {
            "type": "string"
          },
          "nationality": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2"
          },
          "native_name": {
            "type": "string"
          },
          "external_ids": {
            "type": "object",
            "properties": {
              "bnf_ark": {
                "type": "string",
                "pattern": "^ark:/12148/[a-z0-9]+$"
              },
              "wikidata": {
                "type": "string",
                "pattern": "^Q[1-9][0-9]*$"
              }
            },
            "additionalProperties": false
          }
        },
        "x-description": {
          "en": "Person: author, writer, artist, translator, director, actor, composer…",
          "fr": "Personne : auteur, scénariste, dessinateur, traducteur, réalisateur, acteur, compositeur…"
        },
        "additionalProperties": false
      }
    },
